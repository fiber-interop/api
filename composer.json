{
    "name": "fiber-interop/api",
    "description": "One surface for fiber-based concurrency: go, await, sleep, readable, writable on phasync, Revolt, AMPHP and ReactPHP.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "fiber-interop/scope": "^0.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11"
    },
    "autoload": {
        "psr-4": {
            "async\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "async\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/fiber-interop-conformance"
    ],
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
